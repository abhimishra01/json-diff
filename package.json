{
  "name": "json-diff",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4961",
    "build": "astro build",
    "test": "node scripts/test-jd.mjs",
    "test:perf": "node scripts/test-perf.mjs",
    "test:network": "node scripts/test-network.mjs",
