  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "diff": "9.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.1",
    "wrangler": "^4.151.2"
  },
  "engines": {
    "node": ">=22.6"
  }
}
