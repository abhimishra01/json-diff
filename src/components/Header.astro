---
import site from '../site.config.ts';
import ThemeToggle from './ThemeToggle.astro';
import { url, stripBase } from '../lib/url.ts';
const path = stripBase(Astro.url.pathname);
// On narrow phones the last word of the name is cut, so the header fits at 320 px.
const words = site.name.split(' ');
const lead = words.slice(0, -1).join(' ');
const tail = words[words.length - 1];
const links = [
  { href: '/', label: 'Tool' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---
<header class="sticky top-0 z-20 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4">
    <a href={url()} class="flex min-h-11 items-center gap-2.5 font-bold tracking-tight text-ink no-underline">
      <img src={url('favicon.svg')} alt="" width="28" height="28" class="h-7 w-7 rounded-lg" />
      <span class="whitespace-nowrap">{lead} <span class="max-[420px]:sr-only">{tail}</span></span>
    </a>
    <div class="flex items-center gap-1">
      <a href="https://bingemind.com/tools/" class="whitespace-nowrap rounded-full px-3 py-3 text-sm font-medium text-brand-ink no-underline hover:underline max-[420px]:px-2">More free tools</a>
      <nav aria-label="Main" class="flex items-center max-[480px]:hidden">
        {links.map((l) => (
          <a href={url(l.href)} aria-current={path === l.href ? 'page' : undefined}
            class="rounded-full px-3 py-2 text-sm font-medium text-muted no-underline hover:text-ink aria-[current=page]:text-ink aria-[current=page]:bg-brand-soft max-[420px]:px-2">{l.label}</a>
        ))}
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
