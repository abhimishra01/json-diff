---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url.ts';
---
<Base title="Page not found" noindex>
  <section class="mx-auto max-w-5xl px-4 pt-20 sm:pt-28">
    <p class="font-mono text-7xl font-bold text-brand-ink sm:text-8xl">404</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight">This page does not exist.</h1>
    <p class="mt-3 max-w-lg text-lg text-muted">The link may be old or mistyped. The tool is on the home page.</p>
    <a href={url()} class="mt-8 inline-flex rounded-full bg-brand px-6 py-3 font-semibold text-white no-underline hover:opacity-90">Go to the tool</a>
  </section>
</Base>
